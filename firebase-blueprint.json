{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Task representing action items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "deadline": { "type": "string" },
        "urgency": { "type": "string", "enum": ["URGENT", "HIGH", "MEDIUM", "LOW"] },
        "recurring": { "type": "string" },
        "syncedToCalendar": { "type": "boolean" },
        "gmailSourceId": { "type": "string" },
        "project": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "status", "urgency"]
    },
    "Event": {
      "title": "Event",
      "description": "Calendar events synced to Google Calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "meetLink": { "type": "string" },
        "eventSourceId": { "type": "string" },
        "project": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "startTime", "endTime"]
    },
    "Note": {
      "title": "Note",
      "description": "Google Keep Note representation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "timings": { "type": "array" },
        "syncedToCalendar": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Meeting summaries generated by Workspace AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "meetingTitle": { "type": "string" },
        "date": { "type": "string" },
        "meetLink": { "type": "string" },
        "summaryMarkdown": { "type": "string" },
        "actionItems": { "type": "array" },
        "documentId": { "type": "string" },
        "slidesId": { "type": "string" },
        "folderPath": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "meetingTitle", "date", "meetLink"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Client feedback on AI outputs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sourceType": { "type": "string" },
        "sourceId": { "type": "string" },
        "sourceTitle": { "type": "string" },
        "rating": { "type": "integer" },
        "isHelpful": { "type": "boolean" },
        "comment": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sourceType", "sourceId", "rating", "isHelpful"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Action items for a user"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": "Event",
      "description": "Calendar events list"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Keep notes list"
    },
    "/users/{userId}/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Meeting summary and action items"
    },
    "/users/{userId}/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "All AI quality feedback comments"
    }
  }
}
